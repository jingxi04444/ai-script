# Workflow Runner 环境配置示例
# 使用方式：在 workflow-runner 目录执行 cp .env.example .env，修改后重启服务生效。
# 应用从工作目录读取 .env；同名系统环境变量优先于 .env 中的值。
# 此示例启用真实模型网关；只跑前端联调 / Demo 时将 GATEWAY_ENABLED 改为 false。
# .env 仅供 Python 服务读取，Spring Boot 的对应配置需要单独设置。

# ---------- 共用数据库 ----------
# 连接 Spring Boot 使用的同一个 MySQL 数据库，替换 user、password、主机和库名。
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库?charset=utf8mb4
# 用户名或密码中的 @、:、/、#、% 等特殊字符需要进行 URL 编码。
# 运行前需应用 doc/global-database/mysql/migrations/20260904110000_workflow_runner.sql。
WORKFLOW_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/ai_script?charset=utf8mb4

# ---------- Redis Streams 任务与事件 ----------
# 必须与 Spring Boot 使用相同的 Redis 实例和逻辑库；末尾 /0 表示第 0 个库。
# 有密码时使用 redis://:密码@主机:端口/0；密码中的特殊字符同样需要 URL 编码。
# 消费者使用 XAUTOCLAIM，因此 Redis 需要 6.2 或更高版本。
WORKFLOW_REDIS_URL=redis://127.0.0.1:6379/0

# 工作流命令流：Spring Boot 发布启动 / 取消命令，Python 消费。
# 默认如下；修改时同步修改 Spring Boot 的 WORKFLOW_COMMANDS_STREAM。
WORKFLOW_COMMANDS_STREAM=aiscript:workflow:commands

# 执行事件流：Python 发布节点进度、结果和失败事件，Spring Boot 消费并推送前端。
# 默认如下；修改时同步修改 Spring Boot 的 WORKFLOW_EVENTS_STREAM。
WORKFLOW_EVENTS_STREAM=aiscript:workflow:events

# Python 消费组名称。多个 Runner 共用此组以分担命令，启动时会自动创建组。
# 不要为每个实例创建不同组，否则不同组会分别收到同一份命令。
WORKFLOW_CONSUMER_GROUP=python-workflow-runners

# 消费者名称前缀，用于区分机器 / 实例；运行时自动附加主机名和随机后缀。
WORKFLOW_CONSUMER_NAME=python-local

# ---------- 并发与重试 ----------
# 默认 4，建议设置为正整数：限制单个执行器中并行执行的节点数。
# 同时作为每个批量素材节点内部的生成并发上限，并非整个系统的模型请求总上限。
# 多个批量节点 / 多个 Runner 会叠加并发，需要结合供应商限流调整。
WORKFLOW_MAX_CONCURRENCY=4

# 节点默认总尝试次数（包含首次执行）：3 表示首次 + 最多 2 次重试。
# 实际限制为 1—5 次；画布节点的 retryCount（重试次数）可覆盖此默认值。
# 节点重试之间使用指数退避等待。
WORKFLOW_NODE_MAX_ATTEMPTS=3

# 命令处理异常时的总尝试次数（包含首次执行），默认 3，建议设置为正整数。
# 达到上限后进入下面的失败流；已判定为终态失败的工作流会直接进入失败流。
WORKFLOW_COMMAND_MAX_ATTEMPTS=3

# 保存失败命令、错误原因和重试次数的 Redis Stream，便于排查与后续恢复。
# 当前服务不会自动重新消费此失败流。
WORKFLOW_COMMANDS_DEAD_LETTER_STREAM=aiscript:workflow:commands:dead-letter

# ---------- Spring Boot 真实模型网关 ----------
# true：通过 Spring Boot 调用数据库中配置的真实模型。
# false：使用 Demo Skill 模拟执行，不调用真实模型。
# 注意：此示例为 true；没有配置本项时，代码内置默认值为 false。
WORKFLOW_PROVIDER_GATEWAY_ENABLED=true

# Python 调用 Spring Boot 的内部执行接口；这里填写 Java 服务地址，不是供应商地址。
# 轮询地址会自动从 /execute 推导为同级 /poll。
# 容器部署时 127.0.0.1 指向容器自身，应替换为容器能访问的 Spring Boot 地址。
WORKFLOW_PROVIDER_GATEWAY_URL=http://127.0.0.1:8080/api/internal/workflow/providers/execute

# 内部网关鉴权令牌：启用真实网关时必须填写，并与 Spring Boot 的
# WORKFLOW_PROVIDER_GATEWAY_TOKEN 完全一致。两端都要配置，不会自动同步。
# 请替换下面的占位值；这不是模型 API Key，供应商密钥仍由 Spring Boot 管理。
# 实际令牌放在 .env 或系统环境变量中，不要提交到示例文件。
WORKFLOW_PROVIDER_GATEWAY_TOKEN=replace-with-the-same-long-random-token-used-by-spring

# 网关 HTTP 请求超时配置，单位：秒，默认 320；不是整条工作流的总时限。
# 异步任务轮询优先采用网关返回的 maxWaitMs，未返回时才以此值作为等待时限。
WORKFLOW_PROVIDER_GATEWAY_TIMEOUT_SECONDS=320

# ---------- 本地演示与消费者开关 ----------
# Demo Skill 的模拟等待时间，单位：毫秒，默认 180；不控制真实模型生成耗时。
WORKFLOW_SIMULATION_DELAY_MS=180

# true：随 HTTP 服务一起启动 Redis 命令消费者（正常执行工作流必须开启）。
# false：仅启动 HTTP 服务，不消费任务；当前 /health 返回正常不代表消费者可用。
WORKFLOW_WORKER_ENABLED=true

# 启动脚本参数（不是本文件的应用配置项）：
# WORKFLOW_HOST、WORKFLOW_PORT、WORKFLOW_PYTHON_BIN、WORKFLOW_VENV_DIR
# 由 start.sh 从 shell 环境读取，仅写入 .env 不会生效。
# 例如：WORKFLOW_PYTHON_BIN=/opt/homebrew/bin/python3.11 WORKFLOW_PORT=8091 ./start.sh
