APP_DEV_PASSWORD=123456
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
APP_DEFAULT_FRONT_ACCOUNT=linnan@ai-script.local
APP_DEFAULT_ADMIN_ACCOUNT=admin@ai-script.local

# OpenAI-compatible LLM provider. Leave empty to use deterministic local fallbacks.
# Examples:
# DeepSeek: https://api.deepseek.com/v1 + deepseek-chat
# OpenAI: https://api.openai.com/v1 + gpt-4o-mini
# 通义千问 DashScope compatible: https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=3000

# Database-seeded LLM providers use env: references in api_provider_configs.api_key_encrypted.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
