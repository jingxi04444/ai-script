DATABASE_URL=postgresql+psycopg://jingxi:123456@localhost:5432/ai_script_dev
APP_DEV_PASSWORD=123456
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
APP_DEFAULT_FRONT_ACCOUNT=linnan@ai-script.local
APP_DEFAULT_ADMIN_ACCOUNT=admin@ai-script.local

# OpenAI-compatible LLM provider. Leave empty to use deterministic local fallbacks.
# Examples:
# DeepSeek: https://api.deepseek.com/v1 + deepseek-chat
# OpenAI: https://api.openai.com/v1 + gpt-4o-mini
# 通义千问 DashScope compatible: https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=3000

# Video share link parser and ASR transcription.
# VIDEO_PARSE_API_URL supports either a {url} placeholder or direct query prefix.
# Examples:
# VIDEO_PARSE_API_URL=http://127.0.0.1:9000/video/share/url/parse?url=
# VIDEO_PARSE_API_URL=http://127.0.0.1:9000/video/share/url/parse?url={url}
VIDEO_PARSE_API_URL=
VIDEO_PARSE_TIMEOUT_SECONDS=30
# Optional fallback only. Preferred: maintain SiliconFlow ASR in admin API Provider table.
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/audio/transcriptions
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
VIDEO_TEMP_DIR=
VIDEO_AUTO_CLEANUP_TEMP_FILES=true

# Database-seeded LLM providers use env: references in api_provider_configs.api_key_encrypted.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# Alibaba Cloud OSS (all file uploads go to OSS)
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_PROJECT=ai-script-project
OSS_BUCKET_AVATAR=ai-script-avatar
OSS_BUCKET_MATERIAL=ai-script-material
OSS_BUCKET_PUBLIC=ai-script-public
